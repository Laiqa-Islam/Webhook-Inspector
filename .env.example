# Copy to .env.local for local overrides. Every variable is optional locally.

# --- Storage --------------------------------------------------------------
# Required on Vercel (or any multi-instance / serverless host). Without it
# the app uses in-process memory, which only works on a single server.
# Vercel's Redis integrations (Upstash, Redis Cloud) set this for you.
# KV_URL is accepted as a fallback.
REDIS_URL=

# --- Limits ---------------------------------------------------------------
# Requests kept per bin (oldest dropped first).
MAX_REQUESTS_PER_BIN=200
# Bodies larger than this are truncated before storage.
MAX_BODY_KB=256
# Bins are deleted after this many hours without activity.
BIN_TTL_HOURS=24

# --- Rate limits (per minute) ---------------------------------------------
RATE_LIMIT_CAPTURE_PER_MIN=120   # per bin
RATE_LIMIT_REPLAY_PER_MIN=30     # per client IP
RATE_LIMIT_BINS_PER_MIN=10       # per client IP

# --- Replay ---------------------------------------------------------------
# Allow replaying to localhost / private networks. Defaults to true in
# development and false in production. Only enable on a private deployment:
# on a public one it lets anyone use your server to reach internal addresses.
ALLOW_PRIVATE_REPLAY=

# --- Metadata -------------------------------------------------------------
# Absolute site URL for social-share cards. On Vercel the production domain
# is detected automatically; set this for a custom domain.
NEXT_PUBLIC_SITE_URL=
